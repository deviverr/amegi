# ==== Вибір провайдера ШІ ====
# groq  або  openrouter
AI_PROVIDER=groq

# ==== Ключі API (безкоштовні) ====
# Groq:       https://console.groq.com/keys
# OpenRouter: https://openrouter.ai/keys
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ==== Моделі Groq (необов'язково, є типові значення) ====
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ==== Моделі OpenRouter (необов'язково) ====
OPENROUTER_TEXT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_VISION_MODEL=meta-llama/llama-4-scout:free

# ==== Інше ====
HTTP_TIMEOUT=60
WIKI_TOP_K=4
HOST=127.0.0.1
PORT=8000
